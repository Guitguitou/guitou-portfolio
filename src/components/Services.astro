---
import { services } from "../data/site";
---
<section id="services" class="wrap section stack">
  <div class="grid-auto head" style="--min: 300px">
    <div class="col">
      <p class="mono kicker">Services</p>
      <h2 class="h h2">Trois façons de travailler ensemble</h2>
    </div>
    <p class="intro">Que vous partiez de zéro ou d'un existant fatigué, je choisis l'outil adapté à votre besoin, pas l'inverse.</p>
  </div>
  <div class="grid-auto cards" style="--min: 300px">
    {services.map((s) => (
      <article class="card">
        <p class="h num" style={`color: ${s.color}`}>{s.num}</p>
        <h3 class="h">{s.title}</h3>
        <p class="text">{s.text}</p>
        <p class="mono tech">{s.stack}</p>
      </article>
    ))}
  </div>
</section>
<style>
  .stack { display: flex; flex-direction: column; gap: 56px; }
  .head { gap: 24px; align-items: end; }
  .col { display: flex; flex-direction: column; gap: 14px; }
  .intro { margin: 0; font-size: 1.1rem; line-height: 1.65; max-width: 30rem; }
  .cards { border-top: 1.5px solid var(--ink); }
  .card { padding: 36px 28px 40px 0; display: flex; flex-direction: column; gap: 16px; border-bottom: 1.5px solid var(--ink); }
  .num { margin: 0; font-size: 3.2rem; line-height: 1; }
  h3 { margin: 0; font-size: 1.6rem; }
  .text { margin: 0; line-height: 1.65; font-size: 1.05rem; }
  .tech { margin: auto 0 0; color: var(--muted); }
</style>
