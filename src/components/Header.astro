---
import { site, nav } from "../data/site";
---
<header class="wrap header">
  <a href="#top" class="h brand">
    <svg aria-hidden="true" width="28" height="28" viewBox="0 0 28 28"><ellipse cx="14" cy="16" rx="11" ry="9" fill="var(--lemon)"></ellipse><path d="M14 7c2-4 6-5 8-4-1 3-4 5-8 4z" fill="#6E8B3D"></path></svg>
    {site.name}
  </a>
  <nav class="nav-desk" aria-label="Navigation principale">
    {nav.map((l) => <a href={l.href}>{l.label}</a>)}
    <a href="#contact" class="btn btn-dark cta">Me contacter</a>
  </nav>
  <details class="nav-mob" id="nav-mob">
    <summary aria-label="Ouvrir le menu"><span class="bars"></span></summary>
    <nav class="panel" aria-label="Navigation mobile">
      {nav.map((l) => <a href={l.href}>{l.label}</a>)}
      <a href="#contact" class="panel-cta">Me contacter</a>
    </nav>
  </details>
</header>

<script>
  const menu = document.getElementById("nav-mob") as HTMLDetailsElement | null;
  if (menu) {
    menu.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => (menu.open = false)));
    menu.addEventListener("toggle", () => {
      document.body.style.overflow = menu.open ? "hidden" : "";
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && menu.open) menu.open = false;
    });
  }
</script>

<style>
  .header { display: flex; flex-wrap: wrap; gap: 16px; justify-content: space-between; align-items: center; padding-block: 16px; }
  .brand { font-size: 1.25rem; text-decoration: none; display: flex; align-items: center; gap: 10px; padding: 10px 0; }
  .nav-desk { display: flex; flex-wrap: wrap; align-items: center; gap: 4px; }
  .nav-desk a { padding: 12px 14px; text-decoration: none; }
  .nav-desk .cta { padding: 12px 20px; }
  .nav-mob { display: none; position: relative; }
  .nav-mob summary { list-style: none; cursor: pointer; width: 48px; height: 48px; border-radius: 50%; background: var(--ink); display: flex; align-items: center; justify-content: center; }
  .nav-mob summary::-webkit-details-marker { display: none; }
  .bars, .bars::before, .bars::after { display: block; width: 20px; height: 2px; background: var(--cream); border-radius: 2px; position: relative; transition: transform .2s; }
  .bars::before, .bars::after { content: ""; position: absolute; left: 0; }
  .bars::before { top: -6px; }
  .bars::after { top: 6px; }
  .nav-mob[open] .bars { background: transparent; }
  .nav-mob[open] .bars::before { transform: translateY(6px) rotate(45deg); }
  .nav-mob[open] .bars::after { transform: translateY(-6px) rotate(-45deg); }
  .panel { position: absolute; right: 0; top: 60px; z-index: 10; width: min(86vw, 320px); background: var(--cream); border: 1.5px solid var(--ink); border-radius: 20px; padding: 12px; display: flex; flex-direction: column; box-shadow: 0 18px 40px rgba(27, 42, 65, .18); }
  .panel a { padding: 14px 16px; text-decoration: none; font-size: 1.15rem; border-radius: 12px; }
  .panel a:hover { background: var(--sand); }
  .panel .panel-cta { margin-top: 8px; background: var(--ink); color: var(--cream); text-align: center; font-weight: 700; border-radius: 999px; }
  @media (max-width: 640px) { .nav-desk { display: none; } .nav-mob { display: block; } }
  @media (prefers-reduced-motion: reduce) { .bars, .bars::before, .bars::after { transition: none; } }
</style>
